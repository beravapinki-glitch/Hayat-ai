# Copy this file to .env and add your own server-side API key.
# Never put API keys in VITE_ variables or frontend source.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=8787
# Add the production frontend origin(s), comma-separated, when deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost
